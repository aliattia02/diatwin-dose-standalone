# Security reports
security-reports/

# ─── Documentation working area ───────────────────────────────
# Superseded drafts, duplicates, archives and regenerable pipeline
# output parked by the docs cleanup. Nothing here is deleted — it is
# simply kept out of version control.
docs/_draft/

# Large / derived research assets (regenerable from the CGM CSVs
# via docs/Clinical Validation/data files/scripts/)
docs/**/Visual Statistics/
docs/**/*.zip

# Study-participant credentials — never commit
docs/**/*credentials*.json
docs/**/*patient_mapping*.json

# ─── diatwin modelling package ────────────────────────────────────────
# Parity results are regenerated by CI on every run; only the case file
# is meaningful to review in a diff.
diatwin/verify/fixtures/results_*.json
diatwin/**/__pycache__/
.pytest_cache/

# Feature store / model artifacts
data/features/
data/models/
mlruns/
*.parquet

# ─── Excluded from this repository by decision (see docs/engineering/) ───────
# Human-subject data. The AZT1D 2025 CGM records and the HUPA set are real
# per-subject health data and are deliberately not published here. Nothing in
# the test suites reads them; the conversion pipeline expects them to be
# supplied locally.
docs/Clinical Validation/
docs/Clinical validation/

# Study-account credentials. Plaintext passwords and JWTs for 25 accounts.
# These exist in the ORIGINAL repository's history (commits 17ff371, 2f7b5ff)
# and must never be re-committed here.
*credentials*.json
*_credentials.json

# Local environment. Copy mobile/.env.example and create backend/.env locally.
.env
*.env
!*.env.example
!.easignore

# ML training snapshots. Written by diatwin/ml/export.py at the repo root by
# default; may contain patient-derived rows and is regenerable from Mongo, so
# it is never committed. GET /api/ml/snapshots (backend/routes/ml_routes.py)
# reads whatever is here, or wherever ML_SNAPSHOTS_DIR points instead.
/snapshots/
