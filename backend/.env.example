# Copy to backend/.env before running the backend or its test suite:
#     cp backend/.env.example backend/.env
#
# The test suite does not touch a real database — backend/tests/conftest.py
# swaps in mongomock and stubs the schedulers. But `backend/__init__.py`
# imports `config` at module load, and config.py raises if MONGO_URI is unset,
# so the variable has to exist before pytest can even collect. The value below
# is never connected to.
MONGO_URI=mongodb://localhost:27017/diatwin_test
SECRET_KEY=change-me-not-a-real-secret

# Real deployment values belong in the environment, not in this file.
